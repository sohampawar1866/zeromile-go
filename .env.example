# ==============================================================================
# ZeroMile Go — Environment Configuration Template
# Copy this file to `.env` and populate with your project credentials.
# ==============================================================================

# Supabase Project Credentials (BaaS, PostgreSQL, Realtime WebSockets, Phone Auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# OneSignal Push Notification Integration (Official Supabase Partner)
# Create a free app at https://onesignal.com and paste your App ID below:
ONESIGNAL_APP_ID=your-onesignal-app-id-here

# Optional: Mapbox / MapTiler API Key (if using vector custom street basemaps)
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# Local Test Server Port (Default: 8085)
PORT=8085
