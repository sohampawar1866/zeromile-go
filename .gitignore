.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Miscellaneous & Logs
*.class
*.log
*.pyc
*.swp
*.swo
*~
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IDE & Editor Files
*.iml
*.ipr
*.iws
.idea/
.vscode/

# Flutter & Dart Build Outputs & Artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/build/
coverage/
**/coverage/
*.dill
*.track.dill

# Android Build Outputs & Secrets
**/android/local.properties
**/android/.gradle
**/android/captures/
**/android/gradleBuild/
**/android/app/build/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
*.apk
*.aab

# iOS Build Outputs & Pods
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/Pods/
**/ios/.symlinks/
**/ios/profile
**/ios/debug
**/ios/release
**/ios/DerivedData/
*.ipa

# Environment & Secret Credentials
.env
.env.*
!.env.example
config.js
**/config.js
!config.example.js
!**/config.example.js

# Supabase Local
.supabase/

# Node.js & Web
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
